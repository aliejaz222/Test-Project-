---
import { site } from '../config/site';
import { categories, servicesIn } from '../data/services';
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span>Trusted since {site.founded}</span>
      <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
    </div>
  </div>
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <span><strong>{site.name}</strong><small>{site.tagline}</small></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="burger" aria-label="Toggle menu"><span></span><span></span><span></span></label>

    <nav class="main-nav">
      <ul>
        {categories.map((cat) => (
          <li class="has-menu">
            <a href={`/${cat.slug}`}>{cat.name}</a>
            <div class="mega">
              <a href={`/${cat.slug}`} class="mega-title">All {cat.name} →</a>
              <ul>
                {servicesIn(cat.slug).map((s) => (
                  <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
        <li class="has-menu">
          <a href="/about">Company</a>
          <div class="mega small">
            <ul>
              <li><a href="/about">About Us</a></li>
              <li><a href="/portfolio">Portfolio</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/careers">Careers</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
        </li>
      </ul>
      <a href="/contact" class="btn nav-cta">Get a Free Proposal</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--line); }
  .topbar { background: var(--ink); color: #cbd5e1; font-size: .85rem; }
  .topbar-inner { display: flex; justify-content: space-between; padding: 6px 20px; }
  .topbar a { color: #fff; font-weight: 600; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 20px; }
  .logo { display: flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo strong { display: block; font-size: 1.15rem; line-height: 1.1; }
  .logo small { display: block; color: var(--muted); font-size: .75rem; }
  .main-nav { display: flex; align-items: center; gap: 18px; }
  .main-nav > ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .main-nav > ul > li { position: relative; }
  .main-nav > ul > li > a { display: block; padding: 24px 10px; color: var(--ink); font-weight: 600; font-size: .95rem; }
  .main-nav > ul > li > a:hover { color: var(--brand); }
  .mega { display: none; position: absolute; top: 100%; left: -20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 20px 40px -20px rgba(15,23,42,.25); padding: 20px; min-width: 520px; }
  .mega.small { min-width: 220px; }
  .has-menu:hover .mega, .has-menu:focus-within .mega { display: block; }
  .mega ul { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 24px; }
  .mega.small ul { columns: 1; }
  .mega li a { display: block; padding: 6px 0; color: var(--muted); font-size: .92rem; break-inside: avoid; }
  .mega li a:hover { color: var(--brand); }
  .mega-title { display: block; font-weight: 700; margin-bottom: 8px; }
  .nav-cta { padding: 10px 20px; font-size: .9rem; white-space: nowrap; }
  .nav-toggle, .burger { display: none; }

  @media (max-width: 1100px) {
    .burger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 10px; }
    .burger span { width: 24px; height: 2px; background: var(--ink); }
    .main-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; flex-direction: column; align-items: stretch; padding: 10px 20px 24px; border-bottom: 1px solid var(--line); max-height: 80vh; overflow-y: auto; }
    .nav-toggle:checked ~ .main-nav { display: flex; }
    .main-nav > ul { flex-direction: column; }
    .main-nav > ul > li > a { padding: 12px 0; }
    .mega { position: static; display: block; border: 0; box-shadow: none; padding: 0 0 8px 12px; min-width: 0; }
    .mega ul { columns: 1; }
    .mega-title { display: none; }
    .nav-inner { position: relative; }
  }
</style>
