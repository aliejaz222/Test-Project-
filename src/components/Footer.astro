---
import { site } from '../config/site';
import { getCategory, servicesIn } from '../data/services';
const year = new Date().getFullYear();
const cols = ['seo', 'paid-advertising', 'online-marketing', 'web-design'].map((slug) => ({
  cat: getCategory(slug),
  links: servicesIn(slug).slice(0, 7),
}));
const company = [
  ['About Us', '/about'], ['Case Studies', '/portfolio'], ['Reviews', '/reviews'], ['Pricing', '/pricing'],
  ['Partners', '/partners'], ['Client Locations', '/client-locations'], ['Careers', '/careers'], ['Blog', '/blog'],
  ['AI Policy', '/ai-policy'], ['Contact', '/contact'],
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cta">
      <div><h2>Let’s grow your business.</h2><p>Get a free, no-pressure strategy review from our team.</p></div>
      <a href="/contact" class="btn light">Get a Free Proposal</a>
    </div>
    <div class="footer-grid">
      <div>
        <a href="/" class="f-logo">{site.name}</a>
        <p>{site.tagline}. Helping businesses grow online since {site.founded}.</p>
        <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>{site.address}</p>
        <p class="social">
          <a href={site.social.facebook}>Facebook</a><a href={site.social.instagram}>Instagram</a><a href={site.social.linkedin}>LinkedIn</a><a href={site.social.x}>X</a>
        </p>
      </div>
      {cols.map(({ cat, links }) => (
        <div>
          <h4><a href={`/${cat.slug}`}>{cat.menuLabel}</a></h4>
          <ul>{links.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h4>Company</h4>
        <ul>{company.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span class="links"><a href="/ai">AI Services</a><a href="/industries">Industries</a><a href="/sitemap.xml">Sitemap</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #94a3b8; padding: 56px 0 24px; font-size: .92rem; }
  .site-footer a { color: #cbd5e1; }
  .site-footer a:hover { color: #fff; }
  .footer-cta { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; background: var(--brand); border-radius: 20px; padding: 32px 36px; margin-bottom: 48px; }
  .footer-cta h2 { color: #fff; margin: 0 0 4px; font-size: 1.6rem; }
  .footer-cta p { color: #e0e7ff; margin: 0; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr repeat(5, 1fr); gap: 28px; }
  .f-logo { font-size: 1.3rem; font-weight: 800; color: #fff !important; display: block; margin-bottom: 10px; }
  .site-footer h4 { color: #fff; font-size: 1rem; }
  .site-footer h4 a { color: #fff; }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer li { margin-bottom: 6px; }
  .social { display: flex; gap: 12px; flex-wrap: wrap; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-top: 1px solid #1e293b; margin-top: 40px; padding-top: 20px; }
  .footer-bottom .links { display: flex; gap: 16px; flex-wrap: wrap; }
  @media (max-width: 1000px) { .footer-grid { grid-template-columns: 1fr 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } .footer-cta { padding: 24px; } }
</style>
