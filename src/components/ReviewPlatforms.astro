---
import { site } from '../config/site';
// Ratings come from site.ts. Leave a rating empty until you have a real profile with reviews.
const platforms = [
  { name: 'Google', ...site.reviews.google },
  { name: 'Facebook', ...site.reviews.facebook },
  { name: 'Clutch', ...site.reviews.clutch },
];
---
<section class="section">
  <div class="container">
    <h2 class="center">Reviews</h2>
    <div class="grid cols-3" style="margin-top:28px">
      {platforms.map((p) => (
        <a href={p.url} class="card platform" target="_blank" rel="noopener">
          <strong class="pname">{p.name}</strong>
          {p.rating ? (
            <><span class="rating">{p.rating} ★★★★★</span><span class="count">{p.count} reviews</span></>
          ) : (
            <span class="count">Read our reviews on {p.name}</span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .platform { text-align: center; display: flex; flex-direction: column; gap: 6px; }
  .pname { font-size: 1.3rem; }
  .rating { color: #f59e0b; font-weight: 800; font-size: 1.2rem; }
  .count { color: var(--muted); }
</style>
