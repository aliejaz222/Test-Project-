---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { posts } from '../../data/posts';
import { img } from '../../data/images';
import { site } from '../../config/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<Base title={post.title} description={post.excerpt}>
  <section class="hero">
    <div class="container prose">
      <nav class="breadcrumb"><a href="/">Home</a> / <a href="/blog">Blog</a> / {post.category}</nav>
      <h1>{post.title}</h1>
      <p class="lead">{post.excerpt}</p>
      <small>By the {site.name} team · {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</small>
    </div>
  </section>
  <section class="section">
    <article class="container prose">
      <div class="photo" style="aspect-ratio:16/9;margin-bottom:32px"><img src={img(post.image, 1400)} alt="" /></div>
      {post.body.map((b) => (<>{b.h && <h2>{b.h}</h2>}<p>{b.p}</p></>))}
    </article>
  </section>
  <CTA />
</Base>
