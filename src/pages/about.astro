---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { site, yearsInBusiness } from '../config/site';

const values = [
  { title: 'Results first', text: 'We measure success by your revenue and leads, not by activity.' },
  { title: 'Radical transparency', text: 'Clear reporting, honest advice and no hidden fees.' },
  { title: 'Always learning', text: 'Search, ads and AI change fast — so do we.' },
  { title: 'Partnership', text: 'We act as an extension of your team, not a vendor.' },
];
---
<Base title="About Us" description={`Learn about ${site.name}, a full-service digital agency helping businesses grow since ${site.founded}.`}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">About {site.name}</span>
      <h1>Helping businesses grow online since {site.founded}</h1>
      <p class="lead">{site.name} was founded with a simple idea: businesses deserve one partner who can handle every part of digital growth — and be accountable for the results.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid cols-2" style="align-items:center">
      <div>
        <h2>Our story</h2>
        <p>Over the past {yearsInBusiness}+ years we’ve grown from a small team into a full-service agency covering SEO, paid media, social, email, AI and web development.</p>
        <p>Replace this paragraph with your own founding story, milestones and what makes your team different.</p>
      </div>
      <div class="placeholder-img">Replace with a team photo</div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2 class="center">Our values</h2>
      <div class="grid cols-4" style="margin-top:32px">
        {values.map((v) => <div class="card"><h3>{v.title}</h3><p>{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center">Leadership team</h2>
      <div class="grid cols-4" style="margin-top:32px">
        {[1, 2, 3, 4].map(() => (
          <div class="card center">
            <div class="placeholder-img" style="aspect-ratio:1;margin-bottom:16px">Photo</div>
            <h3>Team Member</h3>
            <p>Role / Title</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>
