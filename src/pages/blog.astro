---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { posts } from '../data/posts';
import { img } from '../data/images';
---
<Base title="Blog" description="Practical advice on SEO, AI search, paid ads and web design.">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Insights and Resources</h1>
      <p class="lead">Practical advice on SEO, AI search, advertising and websites, written by our team.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="card post-card">
          <div class="photo"><img src={img(p.image, 700)} alt="" loading="lazy" /></div>
          <span class="eyebrow">{p.category} · {new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          <h3>{p.title}</h3>
          <p>{p.excerpt}</p>
          <span class="more">Read more →</span>
        </a>
      ))}
    </div>
  </section>
  <CTA />
</Base>

<style>
  .post-card .photo { aspect-ratio: 16/9; margin-bottom: 14px; }
</style>
