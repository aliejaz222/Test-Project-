---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import CaseStudyCards from '../components/CaseStudyCards.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CTA from '../components/CTA.astro';
import { categories, servicesIn } from '../data/services';
import { img } from '../data/images';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const list = servicesIn(category.slug);
const groups = [...new Set(list.map((s) => s.group ?? ''))];
---
<Base title={category.name} description={category.intro}>
  <Hero image={category.image} eyebrow={category.name} title={category.headline} subtitle={category.subhead} crumbs={[{ name: 'Home', href: '/' }, { name: category.name }]}>
    <p style="color:#e0e7ff;max-width:600px">{category.intro}</p>
  </Hero>

  <Stats stats={category.stats} />

  <section class="section">
    <div class="container">
      <h2 class="center">Our {category.name} Services</h2>
      {groups.map((g) => (
        <>
          {g && <h3 style="margin-top:40px">{g}</h3>}
          <div class="grid cols-3" style="margin-top:20px">
            {list.filter((s) => (s.group ?? '') === g).map((s) => (
              <a href={`/services/${s.slug}`} class="card cat-card">
                <div class="photo"><img src={img(s.image, 600)} alt={s.name} loading="lazy" /></div>
                <h3>{s.name}</h3>
                <p>{s.subhead}</p>
                <span class="more">Learn more →</span>
              </a>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2 class="center">Why Choose Us</h2>
      <div class="grid cols-3" style="margin-top:32px">
        {category.why.map((w) => <div class="card"><h3>{w.title}</h3><p>{w.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <h2 class="center">Our Process</h2>
      <div class="grid cols-4 steps" style="margin-top:32px">
        {category.process.map((p) => <div class="card"><h3>{p.title}</h3><p>{p.text}</p></div>)}
      </div>
    </div>
  </section>

  <CaseStudyCards items={undefined} title={`${category.name} Case Studies`} />
  <Testimonials />
  <Faq faqs={category.faqs} />
  <CTA />
</Base>

<style>
  .cat-card .photo { aspect-ratio: 16/9; margin-bottom: 14px; }
</style>
